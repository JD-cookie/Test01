# Copy to server/.env to set defaults for this checkout. Variables set in the shell take precedence.
PORT=3000
HOST=0.0.0.0
DB_PATH=data/test01.db
# Apps reporting a lower version get 426 UPGRADE_REQUIRED.
MIN_APP_VERSION=0.0.0
# Valkey for rate-limit counters, shared by all server processes. Unset: kept in this process's memory.
# VALKEY_URL=redis://127.0.0.1:6379/0
# Only behind a reverse proxy: its IPs/CIDRs, so the client address is read from X-Forwarded-For.
# TRUST_PROXY=10.0.0.5
