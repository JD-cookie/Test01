{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(npm:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(mkdir:*)",
      "WebSearch",
      "WebFetch(domain:docs.expo.dev)",
      "WebFetch(domain:reactnative.dev)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:fastify.dev)",
      "WebFetch(domain:www.typescriptlang.org)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.npmjs.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:sqlite.org)",
      "WebFetch(domain:valkey.io)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(/{{APP_CONFIG}}/**)",
      "Edit(/{{APP_CONFIG}}/**)",
      "Read(/{{GH_CONFIG}}/**)",
      "Edit(/{{GH_CONFIG}}/**)",
      "Read(/{{SSH}}/**)",
      "Edit(/{{SSH}}/**)"
    ]
  }
}
