{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "webfetch": "deny",
        "bash": {
          "*": "deny",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git grep*": "allow",
          "grep *": "allow",
          "ls*": "allow"
        }
      }
    }
  }
}
