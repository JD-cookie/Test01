{
  "cli": { "appVersionSource": "local" },
  "build": {
    "staging": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "staging",
        "API_URL": "http://10.0.0.78:4000"
      }
    },
    "production": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "APP_VARIANT": "production"
      }
    }
  }
}
